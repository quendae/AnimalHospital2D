# Optional: URL of the lightweight Colyseus lobby/signaling server.
# Local development defaults to http(s)://<current-host>:2567.
VITE_MULTIPLAYER_URL=http://127.0.0.1:2567

# Optional but strongly recommended for public Internet play. STUN-only P2P can
# fail behind symmetric/strict NAT. Configure your own TURN service here.
# Example: turn:turn.example.com:3478
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
