{
  "name": "animal-care-coop",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "node scripts/start.mjs",
    "predev": "npm run build --workspace @animal-care/shared",
    "dev": "npm run dev --workspace @animal-care/client",
    "predev:server": "npm run build --workspace @animal-care/shared",
    "dev:server": "npm run dev --workspace @animal-care/server",
    "typecheck": "npm run typecheck --workspace @animal-care/client",
    "build": "npm run build --workspace @animal-care/shared && npm run typecheck && npm run build --workspace @animal-care/client && npm run build --workspace @animal-care/server",
    "test": "npm run test --workspace @animal-care/shared",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
